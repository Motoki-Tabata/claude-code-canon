            "settings",
            "skills",
            "subagents"
          ],
          "source": {
            "url": "https://code.claude.com/docs/en/env-vars.md",
            "anchor": "#variables"
          }
        },
        {
          "id": "MAX_THINKING_TOKENS",
          "description_ja": "extended thinking のトークン予算を固定する。`0` で Anthropic API の thinking を切る（切れないモデルがある）。adaptive reasoning のモデルでは正の値の数そのものは無視される。",
          "used_for": [
            "settings"
          ],
          "source": {
            "url": "https://code.claude.com/docs/en/env-vars.md",
            "anchor": "#variables"
          }
