            "subagents"
          ],
          "source": {
            "url": "https://code.claude.com/docs/en/env-vars.md",
            "anchor": "#variables"
          }
        },
        {
          "id": "CLAUDE_CODE_EFFORT_LEVEL",
          "description_ja": "対応モデルの effort level（low・medium・high・xhigh・max・auto）。`--effort`・`/effort`・modelSettings・effortLevel に優先する。maxEffortLevel の上限は残る。",
