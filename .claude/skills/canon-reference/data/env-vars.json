            "mcp"
          ],
          "source": {
            "url": "https://code.claude.com/docs/en/env-vars.md",
            "anchor": "#variables"
          }
        },
        {
          "id": "CLAUDE_CODE_DISABLE_AUTO_MEMORY",
          "description_ja": "`1` で auto memory を無効にする。`0` で `--bare` や autoMemoryEnabled: false があっても有効にする。",
