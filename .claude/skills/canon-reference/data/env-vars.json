          "source": {
            "url": "https://code.claude.com/docs/en/env-vars.md",
            "anchor": "#variables"
          }
        },
        {
          "id": "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS",
          "description_ja": "1セッションで同時に動かせるサブエージェントの数（既定 20）。超えると Agent ツールが起動を断る。",
          "used_for": [
            "subagents"
          ],
          "source": {
            "url": "https://code.claude.com/docs/en/env-vars.md",
            "anchor": "#variables"
          }
        },
        {
          "id": "CLAUDE_CODE_DISABLE_EXPLORE_PLAN_AGENTS",
          "description_ja": "`1` で組み込みの Explore と Plan のサブエージェントを無効にする。同名の独自サブエージェントには影響しない。",
          "used_for": [
            "subagents"
          ],
