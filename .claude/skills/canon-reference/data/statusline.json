        {
          "id": "prompt_cache",
          "type": "object",
          "description_ja": "メインの会話の prompt cache の統計（ヒット率・ミス・warm かどうか）。API 応答のキャッシュのトークン数から計算するので、どのプロバイダーでも使える。subagent のリクエストは数えない。",
          "may_be_absent": true,
          "absent_when_ja": "メインの会話の最初の API 応答の前",
          "source": {
            "url": "https://code.claude.com/docs/en/statusline.md",
