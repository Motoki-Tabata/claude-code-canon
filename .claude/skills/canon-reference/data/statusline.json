          }
        },
        {
          "id": "prompt_cache.warm",
          "type": "boolean",
          "description_ja": "キャッシュ済みの prefix が TTL 内か。直前の応答がキャッシュのトークンを報告しなかったときは、`caching_observed` が `true` でも `false`。",
          "source": {
            "url": "https://code.claude.com/docs/en/statusline.md",
            "anchor": "#prompt-cache-fields"
          }
        },
        {
          "id": "prompt_cache.caching_observed",
