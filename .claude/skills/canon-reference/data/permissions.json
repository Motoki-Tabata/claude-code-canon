            }
          ],
          "notes_ja": "特定のサブエージェントを無効にするには deny に書くか --disallowedTools に渡す。",
          "source": {
            "url": "https://code.claude.com/docs/en/permissions.md",
            "anchor": "#agent-subagents"
          }
        },
        {
          "id": "Skill",
          "applies_to": [
            "Skill"
          ],
          "rule_lists": [
            "allow",
            "ask",
            "deny"
          ],
          "specifier_forms": [
            {
              "form": "Skill(deploy *)",
              "meaning_ja": "skill の名前に一致"
            }
          ],
          "notes_ja": "パラメーターで照合する形は permissions:rule-syntax/Tool(param:value) を参照。",
          "source": {
