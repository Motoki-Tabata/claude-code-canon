            {
              "id": "restartOnCrash",
              "required": false,
              "default": true
            },
            {
              "id": "maxRestarts",
              "required": false
            },
            {
              "id": "diagnostics",
              "required": false,
              "default": true
            }
          ],
          "strict": true,
          "source": {
            "url": "https://code.claude.com/docs/en/plugins/manifest-reference.md",
            "anchor": "#lspservers"
          }
        },
        {
          "id": "outputStyles",
          "type": "path or array of paths",
          "required": false,
          "default": null,
          "description_ja": "output style のファイルかディレクトリ。既定の `output-styles/` の走査を置き換える。",
          "component_relation": {
            "value": "replaces",
            "source": {
              "url": "https://code.claude.com/docs/en/plugins/manifest-reference.md",
