              "default": "stdio"
            },
            {
              "id": "env",
              "required": false
            },
            {
              "id": "initializationOptions",
              "required": false
            },
            {
              "id": "settings",
              "required": false
            },
            {
              "id": "workspaceFolder",
              "required": false
            },
            {
              "id": "startupTimeout",
              "required": false
            },
            {
              "id": "shutdownTimeout",
              "required": false
            },
            {
              "id": "requestTimeout",
