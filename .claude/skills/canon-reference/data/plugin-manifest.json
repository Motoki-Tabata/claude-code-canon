        {
          "id": "experimental",
          "type": "object",
          "required": false,
          "default": null,
          "description_ja": "`themes`・`monitors`・`evals` の入れ物。manifest での形が今後変わりうる。",
          "source": {
            "url": "https://code.claude.com/docs/en/plugins/manifest-reference.md",
            "anchor": "#fields"
          }
        },
        {
          "id": "experimental.themes",
          "type": "path or array of paths",
          "required": false,
          "default": null,
          "description_ja": "テーマのファイルかディレクトリ。既定の `themes/` の走査を置き換える。トップレベルの `themes` も読み込まれるが `claude plugin validate` が警告する。",
          "component_relation": {
            "value": "replaces",
            "source": {
              "url": "https://code.claude.com/docs/en/plugins/manifest-reference.md",
              "anchor": "#how-each-key-combines-with-its-default-location"
            }
          },
          "source": {
            "url": "https://code.claude.com/docs/en/plugins/manifest-reference.md",
            "anchor": "#fields"
          }
        },
        {
          "id": "experimental.monitors",
          "type": "path or inline array",
          "required": false,
          "default": "monitors/monitors.json",
          "description_ja": "monitors の配列を持つ `.json` ファイルか、配列そのもの。省略時は `monitors/monitors.json`。トップレベルの `monitors` も読み込まれるが警告される。対話セッションでだけ動き、Amazon Bedrock・Google Cloud の Agent Platform・Microsoft Foundry では動かない。各要素は strict なオブジェクトで `name`・`command`・`description` が必須。",
          "component_relation": {
            "value": "replaces",
            "source": {
              "url": "https://code.claude.com/docs/en/plugins/manifest-reference.md",
              "anchor": "#how-each-key-combines-with-its-default-location"
            }
          },
          "entry_fields": [
            {
              "id": "name",
              "required": true
            },
            {
              "id": "command",
              "required": true
            },
            {
              "id": "description",
              "required": true
            },
            {
              "id": "when",
              "required": false,
              "default": "always",
              "allowed_values": [
                "always",
                "on-skill-invoke:<skill>"
              ]
            }
          ],
          "strict": true,
          "source": {
            "url": "https://code.claude.com/docs/en/plugins/manifest-reference.md",
            "anchor": "#monitors"
          }
        },
        {
          "id": "experimental.evals",
          "type": "path or array of paths",
          "required": false,
          "default": null,
          "description_ja": "eval のケースを置くディレクトリ（既定の `evals/` でないとき）。コンポーネントのパスではないのでパスの規則は適用されず、`./` は有っても無くてもよい。配列なら先頭だけを使う。`claude plugin eval --eval-dir` が上書きする。",
          "source": {
            "url": "https://code.claude.com/docs/en/plugins/manifest-reference.md",
