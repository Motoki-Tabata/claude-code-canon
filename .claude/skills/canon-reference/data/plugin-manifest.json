          "type": "path or array of paths",
          "required": false,
          "default": null,
          "description_ja": "workflow の `.js` ファイルかディレクトリ。既定の `workflows/` の走査を置き換える。",
          "component_relation": {
            "value": "replaces",
            "source": {
              "url": "https://code.claude.com/docs/en/plugins/manifest-reference.md",
              "anchor": "#how-each-key-combines-with-its-default-location"
            }
          },
          "source": {
            "url": "https://code.claude.com/docs/en/plugins/manifest-reference.md",
            "anchor": "#fields"
